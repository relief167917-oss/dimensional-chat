{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["llm/**/*.ts", "characters/**/*.ts", "prompts/**/*.ts", "scripts/**/*.ts", "round/**/*.ts"]
}
